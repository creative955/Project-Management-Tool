# PostgreSQL connection
DATABASE_URL="postgresql://opshub:opshub@localhost:5432/opshub?schema=public"
# Used by `pnpm test:integration` (the database is reset on every run)
TEST_DATABASE_URL="postgresql://opshub:opshub@localhost:5432/opshub_test?schema=public"

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Extra hosts allowed to call Server Actions behind a proxy (comma-separated, wildcards ok)
SERVER_ACTION_ALLOWED_ORIGINS=""

# Google SSO (optional; the Google button appears when both are set)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 32-byte base64 key for encrypting sensitive fields (bank/tax IDs) — `openssl rand -base64 32`
ENCRYPTION_KEY=""
